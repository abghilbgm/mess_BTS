{
  "manifest_version": 3,
  "name": "Smart WhatsApp Poll Scraper V3",
  "version": "3.0",
  "description": "Stateful auto-scrolling scraper for WhatsApp Web that perfectly captures 100% of polls.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["scraper.js"]
    }
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*"
  ]
}
